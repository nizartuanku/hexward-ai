# hexward-ai tier profile: enterprise-35b
# Tier:     Enterprise (benchmark) — the reference model for the Hexward line.
# Model:    Qwen3.5-35B-A3B Q4_K_M — mixture of experts, 35B total / ~3B active per token,
#           weights licence Apache-2.0 (upstream: Qwen/Qwen3.5-35B-A3B)
# Source:   https://huggingface.co/unsloth/Qwen3.5-35B-A3B-GGUF pinned to commit bc014a17be43adabd7066b7a86075ff935c6a4e2
# Needs:    ~24 GB free RAM (the file is 22.0 GB and is memory-mapped). On a 32 vCPU host with
#           16 threads it generated ~9 tokens/s — faster than Qwen3-8B, because only ~3B
#           parameters are active per token. See docs/verification/2026-11-03-qwen35-benchmark.md.
# Verified: sha256 + size checked by scripts/fetch-model.sh before use.
HEXWARD_AI_TIER=enterprise-35b
HEXWARD_AI_MODEL_FILE=Qwen3.5-35B-A3B-Q4_K_M.gguf
HEXWARD_AI_HF_REPO_PIN=unsloth/Qwen3.5-35B-A3B-GGUF
HEXWARD_AI_HF_REVISION=bc014a17be43adabd7066b7a86075ff935c6a4e2
HEXWARD_AI_MODEL_SHA256=3b46d1066bc91cc2d613e3bc22ce691dd77e6f0d33c9060690d24ce6de494375
HEXWARD_AI_MODEL_BYTES=22016023168
HEXWARD_AI_MODEL_LICENSE=Apache-2.0
HEXWARD_AI_CTX_SIZE=8192
# 1 = products should call with aiclient.WithDisableThinking() (Qwen3.5 reasoning mode off).
HEXWARD_AI_DISABLE_THINKING=1
